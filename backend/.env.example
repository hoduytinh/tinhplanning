# ---- Database ----
# DATA_DIR: thư mục chứa file SQLite (Docker/Railway volume mount path).
DATA_DIR=/data
# DATABASE_URL: để trống sẽ tự suy ra sqlite:///${DATA_DIR}/leadboard.db.
DATABASE_URL=sqlite:////data/leadboard.db

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- App metadata ----
APP_NAME=LeadBoard API
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ---- Auth / JWT ----
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Admin account (set before first run) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-your-secure-password
