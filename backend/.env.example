# ---- Database ----
# Local (Docker Compose / chạy trực tiếp): SQLite, không đổi.
DATA_DIR=/data
# DATABASE_URL: để trống sẽ tự suy ra sqlite:///${DATA_DIR}/leadboard.db.
DATABASE_URL=sqlite:////data/leadboard.db
# Production (Render): set DATABASE_URL là PostgreSQL URL (Supabase) trực
# tiếp trên Render dashboard — không dùng DATA_DIR nữa. Xem .env.example ở
# thư mục gốc để biết chi tiết.

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- App metadata ----
APP_NAME=LeadBoard API
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ---- Auth / JWT ----
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Admin account (set before first run) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-your-secure-password

# ---- AI Assistant (Google Gemini) ----
# Lấy key tại https://aistudio.google.com/apikey. KHÔNG commit key thật.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
