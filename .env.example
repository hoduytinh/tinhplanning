# ==========================================================
# LeadBoard — biến môi trường mẫu
# Copy file này thành .env rồi chỉnh giá trị cho phù hợp.
#   cp .env.example .env
# ==========================================================

# ---------- BACKEND (Production — Render + Supabase) ----------
# Production dùng PostgreSQL (Supabase), KHÔNG dùng SQLite.
# Lấy connection string tại Supabase → Settings → Database → Connection string → URI.
# (Nếu Supabase/Render trả về "postgres://", app tự đổi thành "postgresql://".)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Danh sách domain được phép gọi API (phân cách bằng dấu phẩy).
# Local: cổng Vite. Production: thêm domain Vercel của bạn.
# Ví dụ: http://localhost:5173,https://leadboard.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bảo mật — ĐỔI TRƯỚC KHI DEPLOY (SECRET_KEY tối thiểu 32 ký tự).
SECRET_KEY=your-secret-key-min-32-chars-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Tài khoản admin — set trước lần chạy đầu (seed idempotent).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-your-secure-password

# Môi trường và mức log. Đặt APP_ENV=production trên Render.
APP_ENV=production
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DEBUG=false

# AI Assistant (Google Gemini) — lấy key tại https://aistudio.google.com/apikey
# KHÔNG commit key thật. Chỉ điền vào .env (đã có trong .gitignore).
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# ---------- FRONTEND (Vercel env vars) ----------
# URL của backend API mà frontend sẽ gọi.
# Local: http://localhost:8000
# Production: https://<ten-app>.onrender.com
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=LeadBoard
VITE_APP_VERSION=1.0.0

# ==========================================================
# THAM KHẢO — giá trị thực tế trên từng môi trường
# ==========================================================
#
# LOCAL DEV (Docker Compose — vẫn dùng SQLite như cũ, không đổi):
#   DATA_DIR=/data
#   DATABASE_URL=sqlite:////data/leadboard.db
#   VITE_API_URL=http://localhost:8000
#   APP_ENV=development
#   DEBUG=true
#
# RENDER (production backend, set thủ công trên dashboard vì sync: false
# trong render.yaml — không set qua env var thường):
#   DATABASE_URL=<Supabase connection string ở trên>
#   APP_ENV=production
#
# VERCEL (production frontend):
#   VITE_API_URL=https://leadboard-backend.onrender.com
