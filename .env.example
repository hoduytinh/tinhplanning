# ==========================================================
# LeadBoard — biến môi trường mẫu
# Copy file này thành .env rồi chỉnh giá trị cho phù hợp.
#   cp .env.example .env
# ==========================================================

# ---------- BACKEND (Railway env vars) ----------
# Thư mục chứa file SQLite. Local (Docker) mount volume vào /data.
# Trên Railway: tạo Volume, mount path = /data (hoặc đổi DATA_DIR cho khớp).
DATA_DIR=/data
# DATABASE_URL: để trống sẽ tự suy ra sqlite:///${DATA_DIR}/leadboard.db.
# Set thủ công nếu muốn trỏ tới đường dẫn khác.
DATABASE_URL=sqlite:////data/leadboard.db

# Danh sách domain được phép gọi API (phân cách bằng dấu phẩy).
# Local: cổng Vite. Production: thêm domain Vercel của bạn.
# Ví dụ: http://localhost:5173,https://leadboard.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bảo mật — ĐỔI TRƯỚC KHI DEPLOY (SECRET_KEY tối thiểu 32 ký tự).
SECRET_KEY=your-secret-key-min-32-chars-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Tài khoản admin — set trước lần chạy đầu (seed idempotent).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-your-secure-password

# Môi trường và mức log. Đặt APP_ENV=production trên Railway.
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ---------- FRONTEND (Vercel env vars) ----------
# URL của backend API mà frontend sẽ gọi.
# Local: http://localhost:8000
# Production: https://<ten-app>.up.railway.app
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=LeadBoard
VITE_APP_VERSION=1.0.0
